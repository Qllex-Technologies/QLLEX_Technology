# ============================================================================
# QLLEX TECHNOLOGIES — ROOT .GITIGNORE
# Protects secrets, build outputs, local database files, logs, and OS artifacts.
# ============================================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment variables & secrets (All environments, subdirectories, and variants)
.env
.env.*
.env*.local
*.env
*.env.*
**/.env
**/.env.*
**/.env*.local
!.env.example
!**/.env.example

# Production & TypeScript Build Outputs
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Database, local runtime data & dumps
.data/
**/.data/
*.sqlite
*.db

# Temporary test screenshots & debug artifacts
pin-*.png
test-*.png
scripts/*.png
test-results/
playwright-report/
blob-report/

# Logs & diagnostic dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
diagnostic.data/

# OS Files & System Metadata
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Local deployment outputs & caches
.vercel
.netlify

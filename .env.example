# ============================================================================
# QLLEX TECHNOLOGIES — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in root, apps/api/.env, and apps/web/.env.local
# NEVER commit real credentials, passwords, or secrets to version control.
# ============================================================================

# --- Node & Runtime ---
NODE_ENV=development

# --- Express Backend API (apps/api) ---
PORT=4000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# --- MongoDB Configuration ---
# For Production: Provide your MongoDB Atlas connection URI with username and password.
# For Local Dev: mongodb://127.0.0.1:27017/qllex_db
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>.mongodb.net/qllex_db?retryWrites=true&w=majority
ALLOW_MEMORY_DB_FALLBACK=false

# --- Admin Authentication & Security ---
# Generate a cryptographically secure 64-character secret for production:
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-strong-64-char-production-jwt-secret-key-placeholder
JWT_EXPIRES_IN=8h
ADMIN_BOOTSTRAP_EMAIL=admin@qllex.example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-secure-admin-password-for-production

# --- Email Notification Provider (SMTP / Nodemailer) ---
# Used to dispatch instant enquiry & quote notifications to qllextechnologies@gmail.com.
# In development, leaving SMTP_HOST empty safely outputs notifications to structured console logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=qllextechnologies@gmail.com
SMTP_PASS=replace-with-google-app-password
EMAIL_FROM="QLLEX Technologies Notifications <no-reply@qllextechnologies.com>"
ENQUIRY_NOTIFICATION_EMAIL=qllextechnologies@gmail.com

# --- WhatsApp Business Platform / Cloud API Automation (Optional) ---
# Dispatches real-time WhatsApp enquiry alerts to your business number.
# Obtain access token and phone number ID from Meta for Developers (developers.facebook.com).
# In development, leaving access token empty safely outputs alerts to structured console logs.
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_ACCESS_TOKEN=replace-with-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_RECIPIENT_PHONE=919313188307

# --- Next.js Frontend (apps/web) ---
# Used for canonical URLs, sitemaps, OpenGraph, and API rewrites
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api/v1
INTERNAL_API_URL=https://your-api-domain.com/api/v1
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
